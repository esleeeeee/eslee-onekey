<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.1.3</Version>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Eslee.OneKey.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 탐색기와 작업 표시줄에서 보이는 실행 파일 아이콘입니다. -->
    <ApplicationIcon>Assets\eslee-onekey.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- 창 아이콘으로도 쓰므로 리소스로 함께 넣습니다. -->
    <Resource Include="Assets\eslee-onekey.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Eslee.OneKey.Core\Eslee.OneKey.Core.csproj" />
    <ProjectReference Include="..\Eslee.OneKey.Infrastructure.Windows\Eslee.OneKey.Infrastructure.Windows.csproj" />
  </ItemGroup>
</Project>
