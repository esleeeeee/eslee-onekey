<Window x:Class="Eslee.OneKey.App.AudioQuickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="eslee OneKey 오디오" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="PanelButton" TargetType="ButtonBase">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#3D3A57" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="14,8" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 버튼이 아닌 곳을 잡고 끌면 움직이고, 자동화 버튼 창 가까이 가면 붙습니다. -->
    <Border Background="#F026233B" CornerRadius="12" Padding="12,8,12,12"
            MouseLeftButtonDown="Surface_MouseLeftButtonDown">
        <StackPanel>
            <TextBlock Text="오디오" Foreground="#B9B5D6" FontSize="11" FontWeight="SemiBold" Cursor="SizeAll" />
            <!-- 누르면 바로 그 장치가 기본 출력이 됩니다. 지금 쓰는 쪽이 강조됩니다. -->
            <UniformGrid Columns="2">
                <Button x:Name="SpeakerButton" Style="{StaticResource PanelButton}" MinWidth="72" Margin="0,4,3,0"
                        Click="Speaker_Click" ToolTip="기본 출력 장치를 스피커로 바꿉니다.">
                    <TextBlock Text="스피커" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" />
                </Button>
                <Button x:Name="HeadsetButton" Style="{StaticResource PanelButton}" MinWidth="72" Margin="3,4,0,0"
                        Click="Headset_Click" ToolTip="기본 출력 장치를 헤드셋으로 바꿉니다.">
                    <TextBlock Text="헤드셋" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" />
                </Button>
            </UniformGrid>
            <Button Style="{StaticResource PanelButton}" Click="VolumeMixer_Click"
                    ToolTip="프로그램별 음량을 조절하는 Windows 볼륨 믹서를 엽니다.">
                <TextBlock Text="볼륨 믹서 열기" FontSize="12" />
            </Button>
            <Button x:Name="AutoSwitchButton" Style="{StaticResource PanelButton}" Click="AutoSwitch_Click"
                    ToolTip="켜 두면 자동화를 시작할 때 지정한 출력 장치로 바꿉니다. 끄면 지금 쓰는 장치를 그대로 둡니다.">
                <TextBlock x:Name="AutoSwitchStateText" FontSize="10.5" />
            </Button>
        </StackPanel>
    </Border>
</Window>
