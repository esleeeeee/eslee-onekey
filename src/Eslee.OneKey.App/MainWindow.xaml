<Window x:Class="Eslee.OneKey.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="eslee OneKey" Height="720" Width="860" MinHeight="620" MinWidth="760"
        Background="#F5F6FA" WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="4,0,4,14">
            <TextBlock Text="eslee OneKey" FontSize="28" FontWeight="SemiBold" Foreground="#26233B" />
            <TextBlock Text="단축키로 앱 실행, 오디오 전환, 종료 후 안전 복원" Foreground="#69677A" />
        </StackPanel>

        <TabControl Grid.Row="1" Background="White" BorderBrush="#DDDDE8">
            <TabItem Header="현재 상태">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="#F0EEFF" CornerRadius="10" Padding="18" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock x:Name="AutomationNameStatus" Text="자동화" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="EnabledStatus" Text="설정을 불러오는 중" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="자동화 상태" FontWeight="SemiBold" />
                        <TextBlock x:Name="StateStatus" Grid.Column="1" Text="대기 중" />
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="마지막 실행" FontWeight="SemiBold" />
                        <TextBlock x:Name="LastRunStatus" Grid.Column="1" Text="없음" />
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="마지막 오류" FontWeight="SemiBold" />
                        <TextBlock x:Name="LastErrorStatus" Grid.Column="1" Text="없음" TextWrapping="Wrap" Foreground="#A12828" />
                    </Grid>
                    <WrapPanel Grid.Row="4" VerticalAlignment="Top">
                        <Button x:Name="StartNowButton" Content="지금 실행" Click="StartNow_Click" Background="#6D5DFB" Foreground="White" />
                        <Button x:Name="PauseButton" Content="자동화 일시정지" Click="Pause_Click" />
                        <Button x:Name="ManualRestoreButton" Content="지금 원래 장치로 복원" Click="ManualRestore_Click" />
                        <Button x:Name="KeepCurrentButton" Content="현재 장치 유지 후 종료" Click="KeepCurrent_Click" />
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem Header="설정">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="자동화 이름" VerticalAlignment="Center" />
                        <TextBox x:Name="AutomationNameText" Grid.Column="1" Grid.ColumnSpan="2" />

                        <TextBlock Grid.Row="1" Text="활성화" VerticalAlignment="Center" />
                        <CheckBox x:Name="EnabledCheck" Grid.Row="1" Grid.Column="1" Margin="8" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="2" Text="전역 단축키" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                            <CheckBox x:Name="CtrlCheck" Content="Ctrl" Margin="8" />
                            <CheckBox x:Name="AltCheck" Content="Alt" Margin="8" />
                            <CheckBox x:Name="ShiftCheck" Content="Shift" Margin="8" />
                            <CheckBox x:Name="WinCheck" Content="Win" Margin="8" />
                            <TextBox x:Name="HotkeyText" Width="65" MaxLength="3" />
                        </StackPanel>

                        <TextBlock Grid.Row="3" Text="실행 파일" VerticalAlignment="Center" />
                        <TextBox x:Name="LaunchPathText" Grid.Row="3" Grid.Column="1" />
                        <Button Grid.Row="3" Grid.Column="2" Content="찾기" Click="BrowseLaunch_Click" />

                        <TextBlock Grid.Row="4" Text="종료 감시 프로세스명" VerticalAlignment="Center" />
                        <TextBox x:Name="WatchProcessText" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" />

                        <TextBlock Grid.Row="5" Text="전환 대상 헤드셋" VerticalAlignment="Center" />
                        <ComboBox x:Name="AudioEndpointCombo" Grid.Row="5" Grid.Column="1"
                                  DisplayMemberPath="Name" SelectedValuePath="Id" />
                        <Button Grid.Row="5" Grid.Column="2" Content="새로고침" Click="RefreshAudio_Click" />

                        <TextBlock Grid.Row="6" Text="종료 후 오디오" VerticalAlignment="Center" />
                        <CheckBox x:Name="RestoreAudioCheck" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                                  Content="감시 프로세스 종료 후 원래 장치로 복원 (끄면 현재 장치 유지)" Margin="8"
                                  Checked="RestoreAudioCheck_Changed" Unchecked="RestoreAudioCheck_Changed" />

                        <TextBlock Grid.Row="7" Grid.ColumnSpan="3" Text="Discord 통화 연동 (선택)"
                                   FontWeight="SemiBold" Margin="0,18,0,4" />

                        <TextBlock Grid.Row="8" Text="사용" VerticalAlignment="Center" />
                        <CheckBox x:Name="UseDiscordCheck" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2"
                                  Content="Discord 통화 연동 사용" Margin="8"
                                  Checked="RestoreAudioCheck_Changed" Unchecked="RestoreAudioCheck_Changed" />

                        <TextBlock Grid.Row="9" Text="Discord 실행 파일" VerticalAlignment="Center" />
                        <TextBox x:Name="DiscordPathText" Grid.Row="9" Grid.Column="1"
                                 IsEnabled="{Binding IsChecked, ElementName=UseDiscordCheck}" />
                        <Button Grid.Row="9" Grid.Column="2" Content="찾기" Click="BrowseDiscord_Click"
                                IsEnabled="{Binding IsChecked, ElementName=UseDiscordCheck}" />

                        <TextBlock Grid.Row="10" Text="Discord 프로세스명" VerticalAlignment="Center" />
                        <TextBox x:Name="DiscordProcessText" Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2"
                                 IsEnabled="{Binding IsChecked, ElementName=UseDiscordCheck}" />

                        <TextBlock Grid.Row="11" Text="Discord API URL" VerticalAlignment="Center" />
                        <TextBox x:Name="ApiUrlText" Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2"
                                 IsEnabled="{Binding IsChecked, ElementName=UseDiscordCheck}" />

                        <TextBlock Grid.Row="12" Text="Discord API Token" VerticalAlignment="Center" />
                        <PasswordBox x:Name="ApiTokenPassword" Grid.Row="12" Grid.Column="1" Margin="4" Padding="7"
                                     IsEnabled="{Binding IsChecked, ElementName=UseDiscordCheck}" />
                        <Button Grid.Row="12" Grid.Column="2" Content="연결 확인" Click="TestApi_Click"
                                IsEnabled="{Binding IsChecked, ElementName=UseDiscordCheck}" />

                        <TextBlock Grid.Row="13" Grid.Column="1" Grid.ColumnSpan="2"
                                   Text="Token을 비워 두면 기존 DPAPI 보관값을 유지합니다. 일반 settings.json에는 저장되지 않습니다."
                                   Foreground="#69677A" TextWrapping="Wrap" Margin="6,0,0,8" />

                        <TextBlock Grid.Row="14" Grid.ColumnSpan="3" Text="음성채널 자동 입장 (선택)"
                                   FontWeight="SemiBold" Margin="0,18,0,4" />

                        <TextBlock Grid.Row="15" Text="사용" VerticalAlignment="Center" />
                        <CheckBox x:Name="AutoJoinVoiceCheck" Grid.Row="15" Grid.Column="1" Grid.ColumnSpan="2"
                                  Content="자동화 시작 시 지정한 음성채널에 입장 (다른 통화 중이면 건너뜀)" Margin="8"
                                  IsEnabled="{Binding IsChecked, ElementName=UseDiscordCheck}" />

                        <TextBlock Grid.Row="16" Text="음성채널 링크/ID" VerticalAlignment="Center" />
                        <TextBox x:Name="VoiceChannelTargetText" Grid.Row="16" Grid.Column="1" Grid.ColumnSpan="2"
                                 IsEnabled="{Binding IsChecked, ElementName=AutoJoinVoiceCheck}" />

                        <TextBlock Grid.Row="17" Text="RPC Client ID" VerticalAlignment="Center" />
                        <TextBox x:Name="RpcClientIdText" Grid.Row="17" Grid.Column="1"
                                 IsEnabled="{Binding IsChecked, ElementName=AutoJoinVoiceCheck}" />
                        <Button x:Name="ConnectRpcButton" Grid.Row="17" Grid.Column="2" Content="Discord 연결"
                                Click="ConnectRpc_Click"
                                IsEnabled="{Binding IsChecked, ElementName=AutoJoinVoiceCheck}" />

                        <TextBlock Grid.Row="18" Text="RPC Client Secret" VerticalAlignment="Center" />
                        <PasswordBox x:Name="RpcClientSecretPassword" Grid.Row="18" Grid.Column="1" Margin="4" Padding="7"
                                     IsEnabled="{Binding IsChecked, ElementName=AutoJoinVoiceCheck}" />
                        <TextBlock x:Name="RpcStatusText" Grid.Row="18" Grid.Column="2"
                                   Text="미연결" VerticalAlignment="Center" Foreground="#69677A" />

                        <TextBlock Grid.Row="19" Grid.Column="1" Grid.ColumnSpan="2"
                                   Text="본인 Discord 애플리케이션을 만들고 Redirect URI에 http://localhost/onekey 를 등록하세요. Public Client를 켜면 Secret 없이 연결됩니다. Secret은 DPAPI에만 보관되며 settings.json에 저장되지 않습니다."
                                   Foreground="#69677A" TextWrapping="Wrap" Margin="6,0,0,8" />

                        <TextBlock Grid.Row="20" Text="복원 정책" VerticalAlignment="Center" />
                        <CheckBox x:Name="DeferRestoreCheck" Grid.Row="20" Grid.Column="1" Grid.ColumnSpan="2"
                                  Content="Discord 통화 중이면 복원 보류 (자동 복원을 켠 경우에만 적용)" Margin="8" />

                        <TextBlock Grid.Row="21" Text="Windows 시작" VerticalAlignment="Center" />
                        <CheckBox x:Name="StartupCheck" Grid.Row="21" Grid.Column="1" Grid.ColumnSpan="2"
                                  Content="로그인 시 자동 실행" Margin="8" />

                        <WrapPanel Grid.Row="22" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
                            <Button x:Name="SaveSettingsButton" Content="설정 저장 및 적용" Click="SaveSettings_Click" Background="#6D5DFB" Foreground="White" />
                        </WrapPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="정보">
                <StackPanel Margin="24">
                    <TextBlock x:Name="VersionText" Text="eslee OneKey" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="단축키로 앱 실행, 오디오 전환, 종료 후 안전 복원"
                               Foreground="#69677A" Margin="0,6,0,18" />
                    <TextBlock x:Name="UpdateStatusText" Text="업데이트를 아직 확인하지 않았습니다."
                               TextWrapping="Wrap" Margin="0,0,0,12" />
                    <WrapPanel>
                        <Button x:Name="CheckUpdateButton" Content="업데이트 확인" Click="CheckUpdate_Click" />
                        <Button Content="Release 페이지 열기" Click="OpenReleasePage_Click" />
                    </WrapPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
