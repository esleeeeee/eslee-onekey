<Window x:Class="Eslee.OneKey.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="eslee OneKey" Height="760" Width="1020" MinHeight="640" MinWidth="900"
        Background="#F5F6FA" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!--
            도움말 표시입니다. 특정 글꼴에만 있는 글자를 쓰면 없는 환경에서 네모로
            깨지므로, 원과 물음표를 직접 그립니다. 마우스를 올리거나 키보드로
            이동해도 설명이 뜹니다.
        -->
        <Style x:Key="Hint" TargetType="ContentControl">
            <!--
                설명은 WPF가 알아서 열고 닫습니다. 직접 열고 닫으려 하지 않습니다.
                손으로 여닫던 때는 물음표를 누르면 창이 닫혀 버렸습니다.
            -->
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <!-- 기다리지 않고 바로 뜨게 합니다. 기본값은 1초 가까이 걸립니다. -->
            <Setter Property="ToolTipService.InitialShowDelay" Value="0" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0" />
            <Setter Property="ToolTipService.ShowDuration" Value="60000" />
            <Setter Property="ToolTipService.Placement" Value="Bottom" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border x:Name="Circle" Width="16" Height="16" CornerRadius="8"
                                Background="#DCDAEA" SnapsToDevicePixels="True">
                            <TextBlock Text="?" FontSize="11" FontWeight="Bold" Foreground="#4A4766"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#C7C3DE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 상단 막대의 버튼은 크기와 여백을 맞춥니다. -->
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!--
            세로로 쌓인 패널에서 토글은 기본으로 가로 전체를 차지합니다. 그러면 같은 줄의
            빈 공간을 눌러도 상태가 바뀝니다. 박스와 글자만 눌리도록 왼쪽에 붙입니다.
        -->
        <Style TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#26233B" />
        </Style>
        <Style x:Key="SectionNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#69677A" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,10" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="140" />
        </Style>
        <Style x:Key="Row" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="4,0,4,12">
            <TextBlock Text="eslee OneKey" FontSize="26" FontWeight="SemiBold" Foreground="#26233B" />
            <TextBlock Text="단축키 하나로 게임과 통화 환경을 한 번에 준비합니다" Foreground="#69677A" />
        </StackPanel>

        <TabControl x:Name="MainTabs" Grid.Row="1" Background="White" BorderBrush="#DDDDE8">

            <!-- ══════════════ 자동화 ══════════════ -->
            <TabItem Header="자동화">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 전역 상태 막대 -->
                    <Border Grid.Row="0" Background="#F0EEFF" Padding="16,12" BorderBrush="#DDDDE8" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="GlobalStateText" Text="설정을 불러오는 중" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="LastRunStatus" Text="" Foreground="#69677A" Margin="14,0,0,0" VerticalAlignment="Center" />
                                <Button x:Name="PauseButton" Content="자동화 일시정지" Click="Pause_Click"
                                        Style="{StaticResource BarButton}" Margin="18,0,0,0" />
                                <Button x:Name="ManualRestoreButton" Content="지금 원래 장치로 복원" Click="ManualRestore_Click"
                                        Style="{StaticResource BarButton}" Visibility="Collapsed" />
                                <Button x:Name="KeepCurrentButton" Content="현재 장치 유지 후 종료" Click="KeepCurrent_Click"
                                        Style="{StaticResource BarButton}" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock x:Name="LastErrorStatus" Text="" Foreground="#A12828" TextWrapping="Wrap"
                                       Margin="0,6,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="290" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 왼쪽: 자동화 목록 -->
                        <DockPanel Grid.Column="0" Background="#FAFAFD" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Bottom" Margin="10">
                                <Button Content="+ 새 자동화" Click="AddAutomationRule_Click" HorizontalAlignment="Stretch" />
                                <Button Content="선택한 자동화 복제" Click="DuplicateAutomationRule_Click" HorizontalAlignment="Stretch" />
                                <Button Content="선택한 자동화 삭제" Click="DeleteAutomationRule_Click" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <ListBox x:Name="AutomationList" BorderThickness="0" Background="Transparent"
                                     SelectionChanged="AutomationRule_SelectionChanged"
                                     HorizontalContentAlignment="Stretch" Margin="6">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,10" CornerRadius="8" Margin="0,2">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Tag="{Binding}"
                                                          Click="ToggleRuleEnabled_Click" VerticalAlignment="Center"
                                                          ToolTip="끄면 이 자동화의 단축키가 동작하지 않습니다." />
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding HotkeyText}" Foreground="#69677A" FontSize="11" />
                                                    <TextBlock Text="{Binding StateText}" Foreground="#6D5DFB" FontSize="11" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- 오른쪽: 선택한 자동화의 설정 -->
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="22,18,22,22">

                                <!-- 기본 설정 -->
                                <TextBlock Text="기본 설정" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="이 자동화의 이름과 실행 단축키입니다." Style="{StaticResource SectionNote}" />
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="자동화 사용" Style="{StaticResource FieldLabel}" />
                                    <CheckBox x:Name="EnabledCheck" Content="이 자동화를 사용합니다" VerticalAlignment="Center"
                                              Checked="FeatureToggle_Changed" Unchecked="FeatureToggle_Changed" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="이름" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="AutomationNameText" Width="280" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="단축키" Style="{StaticResource FieldLabel}" />
                                    <CheckBox x:Name="CtrlCheck" Content="Ctrl" Margin="6,0" VerticalAlignment="Center" />
                                    <CheckBox x:Name="AltCheck" Content="Alt" Margin="6,0" VerticalAlignment="Center" />
                                    <CheckBox x:Name="ShiftCheck" Content="Shift" Margin="6,0" VerticalAlignment="Center" />
                                    <CheckBox x:Name="WinCheck" Content="Win" Margin="6,0" VerticalAlignment="Center" />
                                    <TextBox x:Name="HotkeyText" Width="60" MaxLength="3" />
                                    <ContentControl Style="{StaticResource Hint}" ToolTip="이 키 조합을 누르면 해당 자동화가 실행됩니다." />
                                </StackPanel>
                                <WrapPanel Margin="140,4,0,18">
                                    <Button x:Name="StartNowButton" Content="지금 실행" Click="StartNow_Click"
                                            Background="#6D5DFB" Foreground="White" />
                                </WrapPanel>

                                <!-- 프로그램 -->
                                <Separator Margin="0,0,0,14" />
                                <TextBlock Text="프로그램" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="자동화를 시작할 때 실행할 프로그램과, 종료를 지켜볼 프로그램입니다." Style="{StaticResource SectionNote}" />
                                <CheckBox x:Name="UseProgramCheck" Content="프로그램 실행 사용" Margin="0,0,0,8"
                                          Checked="FeatureToggle_Changed" Unchecked="FeatureToggle_Changed" />
                                <StackPanel x:Name="ProgramPanel" Margin="16,0,0,18">
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="실행 파일" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="LaunchPathText" Width="360" />
                                        <Button Content="찾기" Click="BrowseLaunch_Click" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="종료 감시 프로그램" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="WatchProcessText" Width="280" />
                                        <ContentControl Style="{StaticResource Hint}"
                                                   ToolTip="이 프로그램이 종료되면 OneKey가 자동화가 끝난 것으로 판단합니다." />
                                    </StackPanel>
                                </StackPanel>

                                <!-- 계정 로그인 -->
                                <Separator Margin="0,0,0,14" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="계정 로그인" Style="{StaticResource SectionTitle}" />
                                    <ContentControl Style="{StaticResource Hint}"
                                               ToolTip="저장된 로그인 세션으로 계정을 자동 전환합니다. 비밀번호는 저장하지 않습니다." />
                                </StackPanel>
                                <TextBlock Text="이 자동화를 실행할 때 저장된 로그인 세션으로 전환합니다. 비밀번호는 저장하지 않습니다."
                                           Style="{StaticResource SectionNote}" />
                                <CheckBox x:Name="UseAccountCheck" Content="계정 로그인 사용" Margin="0,0,0,8"
                                          Checked="FeatureToggle_Changed" Unchecked="FeatureToggle_Changed" />
                                <StackPanel x:Name="AccountPanel" Margin="16,0,0,18">
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="상태" Style="{StaticResource FieldLabel}" />
                                        <TextBlock x:Name="AccountStatusText" Text="확인 중..." FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <WrapPanel Margin="140,0,0,6">
                                        <Button Content="현재 로그인 계정 등록" Click="CaptureAccountSession_Click" />
                                        <Button Content="지금 이 계정으로 전환" Click="SwitchToAccount_Click" />
                                        <Button Content="다른 계정 로그인 화면 열기" Click="OpenOtherAccountSignIn_Click" />
                                    </WrapPanel>
                                    <TextBlock Foreground="#A12828" TextWrapping="Wrap" Margin="140,0,0,8"
                                               Text="게임 런처에서 직접 로그아웃하면 저장해 둔 로그인 세션이 무효가 될 수 있습니다." />
                                    <Expander Header="고급 (세션 파일과 프로세스 이름)" Margin="140,0,0,0" Foreground="#69677A">
                                        <StackPanel Margin="0,8,0,0">
                                            <StackPanel Style="{StaticResource Row}">
                                                <TextBlock Text="세션 파일" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="SessionFilePathText" Width="360" />
                                            </StackPanel>
                                            <StackPanel Style="{StaticResource Row}">
                                                <TextBlock Text="런처 프로세스" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="LauncherProcessesText" Width="360" />
                                            </StackPanel>
                                            <StackPanel Style="{StaticResource Row}">
                                                <TextBlock Text="게임 프로세스" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="BlockingProcessesText" Width="360" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>

                                <!-- 오디오 -->
                                <Separator Margin="0,0,0,14" />
                                <TextBlock Text="오디오" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="자동화를 시작할 때 쓸 출력 장치와, 끝난 뒤 어떻게 할지를 정합니다." Style="{StaticResource SectionNote}" />
                                <CheckBox x:Name="UseAudioCheck" Content="오디오 장치 변경 사용" Margin="0,0,0,8"
                                          Checked="FeatureToggle_Changed" Unchecked="FeatureToggle_Changed" />
                                <StackPanel x:Name="AudioPanel" Margin="16,0,0,18">
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="사용할 출력 장치" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="AudioEndpointCombo" Width="320" DisplayMemberPath="Name" SelectedValuePath="Id" />
                                        <Button Content="새로고침" Click="RefreshAudio_Click" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="자동화 종료 후" Style="{StaticResource FieldLabel}" />
                                        <StackPanel>
                                            <RadioButton x:Name="KeepDeviceRadio" GroupName="RestorePolicy" Content="현재 장치 유지"
                                                         Checked="FeatureToggle_Changed" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <RadioButton x:Name="RestoreDeviceRadio" GroupName="RestorePolicy" Content="실행 전 장치로 복원"
                                                             Checked="FeatureToggle_Changed" />
                                                <ContentControl Style="{StaticResource Hint}"
                                                           ToolTip="자동화가 끝나면 시작하기 전에 사용하던 오디오 장치로 돌아갑니다." />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel x:Name="DeferRestorePanel" Margin="140,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox x:Name="DeferRestoreCheck" Content="Discord 통화가 끝날 때까지 복원 기다리기" />
                                            <ContentControl Style="{StaticResource Hint}"
                                                       ToolTip="자동화가 끝나도 Discord 통화 중이면 오디오 장치를 바로 되돌리지 않습니다. 통화가 끝나면 자동으로 복원합니다." />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Discord -->
                                <Separator Margin="0,0,0,14" />
                                <TextBlock Text="Discord" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="자동화를 실행할 때 Discord를 함께 준비합니다." Style="{StaticResource SectionNote}" />
                                <CheckBox x:Name="UseDiscordCheck" Content="Discord 연동 사용" Margin="0,0,0,8"
                                          Checked="FeatureToggle_Changed" Unchecked="FeatureToggle_Changed" />
                                <StackPanel x:Name="DiscordPanel" Margin="16,0,0,18">
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="연결 상태" Style="{StaticResource FieldLabel}" />
                                        <TextBlock x:Name="RpcStatusText" Text="확인 중..." VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <Button x:Name="ConnectRpcButton" Content="Discord 다시 연결" Click="ConnectRpc_Click" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                        <CheckBox x:Name="AutoJoinVoiceCheck" Content="음성채널 자동 입장"
                                                  Checked="FeatureToggle_Changed" Unchecked="FeatureToggle_Changed" />
                                        <ContentControl Style="{StaticResource Hint}"
                                                   ToolTip="자동화를 실행하면 선택한 Discord 음성채널에 자동으로 들어갑니다." />
                                    </StackPanel>
                                    <StackPanel x:Name="AutoJoinPanel" Margin="16,0,0,0">
                                        <StackPanel Style="{StaticResource Row}">
                                            <TextBlock Text="서버" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="GuildCombo" Width="320" DisplayMemberPath="Name" SelectedValuePath="Id"
                                                      SelectionChanged="GuildCombo_SelectionChanged" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource Row}">
                                            <TextBlock Text="음성채널" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="VoiceChannelCombo" Width="320" DisplayMemberPath="Name" SelectedValuePath="Id" />
                                            <Button Content="목록 새로고침" Click="RefreshDiscordLists_Click" />
                                        </StackPanel>
                                        <TextBlock x:Name="DiscordListStatusText" Text="" Foreground="#69677A"
                                                   TextWrapping="Wrap" Margin="140,0,0,6" />
                                        <Expander Header="목록에서 고를 수 없을 때" Margin="140,0,0,0" Foreground="#69677A">
                                            <StackPanel Style="{StaticResource Row}" Margin="0,8,0,0">
                                                <TextBlock Text="채널 직접 입력" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="VoiceChannelTargetText" Width="320" />
                                                <ContentControl Style="{StaticResource Hint}"
                                                           ToolTip="목록에 나오지 않을 때만 채널 링크나 ID를 직접 넣습니다." />
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </StackPanel>

                                <Separator Margin="0,0,0,14" />
                                <WrapPanel>
                                    <Button x:Name="SaveSettingsButton" Content="이 자동화 저장" Click="SaveSettings_Click"
                                            Background="#6D5DFB" Foreground="White" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ══════════════ 앱 설정 ══════════════ -->
            <TabItem Header="앱 설정">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <TextBlock Text="앱 설정" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="OneKey 자체에 대한 설정입니다. 개별 자동화와는 무관합니다." Style="{StaticResource SectionNote}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Windows 시작" Style="{StaticResource FieldLabel}" />
                            <CheckBox x:Name="StartupCheck" Content="로그인 시 자동 실행" VerticalAlignment="Center" />
                        </StackPanel>
                        <WrapPanel Margin="140,6,0,20">
                            <Button Content="앱 설정 저장" Click="SaveAppSettings_Click" Background="#6D5DFB" Foreground="White" />
                        </WrapPanel>

                        <Expander Header="고급 설정" Foreground="#69677A">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource SectionNote}"
                                           Text="평소에는 건드릴 필요가 없습니다. 기본값으로 동작하지 않을 때만 사용하세요." />
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="RPC Client ID" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="RpcClientIdText" Width="280" />
                                    <ContentControl Style="{StaticResource Hint}"
                                               ToolTip="비워 두면 OneKey 기본 애플리케이션을 사용합니다." />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="봇 API URL" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ApiUrlText" Width="360" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="봇 API Token" Style="{StaticResource FieldLabel}" />
                                    <PasswordBox x:Name="ApiTokenPassword" Width="280" Padding="7" />
                                    <Button Content="연결 확인" Click="TestApi_Click" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource SectionNote}" Margin="140,0,0,10"
                                           Text="Token을 비워 두면 기존 보관값을 유지합니다. 설정 파일에는 저장되지 않습니다." />
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Discord 실행 파일" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="DiscordPathText" Width="360" />
                                    <Button Content="찾기" Click="BrowseDiscord_Click" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Discord 프로세스명" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="DiscordProcessText" Width="280" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource SectionNote}" Margin="140,0,0,0"
                                           Text="이 값들은 OneKey 전체에 하나만 있습니다. 어느 자동화를 보고 있든 같습니다." />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════ 정보 ══════════════ -->
            <TabItem Header="정보">
